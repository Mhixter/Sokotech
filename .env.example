NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/sokotech
SESSION_SECRET=replace-with-at-least-32-random-bytes
PIN_ENCRYPTION_KEY=replace-with-a-64-character-hex-encoded-32-byte-key
PIN_FINGERPRINT_KEY=replace-with-a-different-64-character-hex-encoded-32-byte-key
IDENTITY_ENCRYPTION_KEY=replace-with-another-64-character-hex-encoded-32-byte-key
# Production administrator bootstrap; never use for local demo accounts.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=
# Local demo sandbox; seed:demo only accepts database "sokotech_demo" in development.
ENABLE_DEMO_SEED=false
DEMO_ADMIN_PASSWORD=
